# GeoPilot AI â€” example only. Never place real secrets in source control.

APP_ENV=development
APP_NAME=GeoPilot AI
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=GeoPilot AI
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Database values are placeholders for local development only.
POSTGRES_DB=geopilot
POSTGRES_USER=geopilot
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://geopilot:change-me-local-only@db:5432/geopilot

# AI provider selection: ollama | openai
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=openai

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_PLANNING_MODEL=qwen3:8b

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PLANNING_MODEL=gpt-5.6-luna

# Satellite/document external provider credentials are intentionally undefined until their task introduces a concrete adapter.

# Database readiness
DB_CONNECT_TIMEOUT_SECONDS=5

# Backend foundation
APP_VERSION=0.0.20
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Authentication (change before any non-local deployment)
AUTH_JWT_SECRET=local-development-change-me-at-least-32-bytes
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_ISSUER=geopilot-ai
DOCUMENT_STORAGE_ROOT=/data/documents
DOCUMENT_UPLOAD_MAX_BYTES=104857600

# Document embedding/index pipeline (TASK-020)
EMBEDDING_PROVIDER=ollama
EMBEDDING_FALLBACK_PROVIDER=openai
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_BASE_URL=https://api.openai.com/v1
# Required only when OpenAI is used for embeddings; GPT-5.6 Luna remains the planning LLM, not the embedding model.
OPENAI_EMBEDDING_MODEL=

# PLAN-Ai Hackathon 2026 â€” Track B closed-evidence mode
RASTER_STORAGE_ROOT=/data/rasters
RASTER_UPLOAD_MAX_BYTES=1073741824
TRACK_B_MAX_ANALYSIS_PIXELS=16000000

# Automatic terrain acquisition (CDSE Copernicus DEM GLO-30)
# Real OAuth credentials belong only in the local .env, never in source control.
TERRAIN_AUTO_ACQUISITION_ENABLED=false
TERRAIN_AUTO_PROVIDER=copernicus_cdse
TERRAIN_AUTO_TARGET_CRS=EPSG:32647
TERRAIN_CDSE_CLIENT_ID=YOUR_TERRAIN_CDSE_CLIENT_ID
TERRAIN_CDSE_CLIENT_SECRET=YOUR_TERRAIN_CDSE_CLIENT_SECRET

